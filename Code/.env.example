# Kopie als .env anlegen und Werte eintragen.
# Der AES-Schluessel muss exakt 16 Zeichen lang sein (AES-128).

AES_MAIN=0123456789ABCDEF
WIFI_SSID=MeinNetzwerk
WIFI_PASS=MeinPasswort
SMTP_USER=absender@gmail.com
SMTP_PASS=app-passwort
RECIPIENTS=empfaenger1@example.com,empfaenger2@example.com
# Zugang zum Web-Portal (Benutzer: admin). Leer = Portal ohne Login.
PORTAL_PASS=sicheres-portal-passwort
